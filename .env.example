PROJECT_NAME="TalentMatch AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (SQLite by default, or PostgreSQL)
DATABASE_URL="sqlite:///./talentmatch.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/talentmatch"

# Redis & Celery (Optional for local dev, automatic fallback to threadpool)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Upload and Security Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=15
MAX_BATCH_SIZE_MB=100

# Embedding Model Configuration
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
DEVICE="cpu"

# Default Scoring Weights
DEFAULT_WEIGHT_SKILLS=0.35
DEFAULT_WEIGHT_SEMANTIC=0.25
DEFAULT_WEIGHT_EXPERIENCE=0.20
DEFAULT_WEIGHT_EDUCATION=0.10
DEFAULT_WEIGHT_RESPONSIBILITY=0.10
